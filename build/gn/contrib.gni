template("contrib_tool") {
    executable(target_name) {
        forward_variables_from(invoker, "*", [ "configs", "deps" ])

        # Override default deps
        deps = []
        deps = platform_deps + [ "//contrib/libs/cxxsupp/libcxx" ]
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }
    }
}

template("contrib_library") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")

    target(library_type, target_name) {
        forward_variables_from(invoker, "*", [ "configs", "deps" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = "${_unique_name}_${target_name}"

        # Override default deps
        deps = []
        deps = platform_deps + [ "//contrib/libs/cxxsupp/libcxx" ]
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }
    }
}

template("system_library") {
    static_library(target_name) {
        forward_variables_from(invoker, "*", [ "configs", "deps" ])

        # Use only platform deps
        deps = []
        deps = platform_deps
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }
    }
}
