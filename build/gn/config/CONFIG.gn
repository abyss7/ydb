# =============================================================================
# Imports
# =============================================================================

import("//build/gn/base.gni")
import("//build/gn/contrib.gni")
import("//build/gn/flatbuffers.gni")
import("//build/gn/protobuf.gni")
import("//build/gn/python.gni")
import("//build/gn/rodata.gni")

import("//build/gn/config/${host_os}/deps.gni")

# =============================================================================
# Arguments
# =============================================================================

declare_args() {
  build_type = "debug"
  compiler = "clang"
  library_type = "shared_library"
}

assert(build_type == "debug" || build_type == "release",
       "unknown build_type specified: ${build_type}")

assert(compiler == "clang",
       "unknown compiler specified: ${compiler}")

assert(library_type == "shared_library" || library_type == "static_library",
       "unknown library specified: ${library_type}")

# =============================================================================
# Configurations and dependencies
# =============================================================================

_default_configs = [
  "//build/gn/config:base",
  "//build/gn/config:no_stdlibs",
  "//build/gn/config:threads",
  "//build/gn/config:${build_type}",
  "//build/gn/config:${library_type}",
  "//build/gn/config/${host_os}:base",
  "//build/gn/config:std_string",
  "//build/gn/config:no_undefined",
]
_default_deps = [
  # "//contrib/libs/tcmalloc:default", # TODO: repair this
  "//library/cpp/malloc/tcmalloc",
  "//util",
]

foreach(_target_type, [
  "static_library",
  "shared_library",
  "executable",
  "source_set",
]) {
  set_defaults(_target_type) {
    configs = _default_configs
    deps = _default_deps + platform_deps
  }
}

# =============================================================================
# Toolchains
# =============================================================================

set_default_toolchain("//build/gn/toolchain/${host_os}:${compiler}")
