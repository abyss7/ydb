config("_avx_config") {
    cflags = [
        "-mavx",
        "-mpclmul",
    ]
}

config("_avx2_config") {
    cflags = [
        "-mavx2",
        "-mfma",
        "-mbmi",
        "-mbmi2",
    ]
}

config("_avx512_config") {
    cflags = [
        "-mavx512bw",
        "-mavx512cd",
        "-mavx512dq",
        "-mavx512f",
        "-mavx512vl",
        "-mvpclmulqdq",
    ]
}

config("_sse2_config") {
    cflags = [
        "-msse2",
    ]
}

config("_sse41_config") {
    cflags = [
        "-msse4.1",
    ]
}

config("_sse42_config") {
    cflags = [
        "-msse4.2",
    ]
}

config("_ssse3_config") {
    cflags = [
        "-mssse3",
    ]
}

config("base") {
    cflags = [
        "-pipe",
        "-Wall",
        "-Werror",
        "-Wsign-compare",
        "-Wno-unknown-warning-option",

        # some disrespected common warnings
        "-Wno-format",
        "-Wno-format-security",
        "-Wno-logical-op-parentheses",
        "-Wno-parentheses",
        "-Wno-vla-cxx-extension",
    ]

    cflags_cc = [
        "-std=c++20",
        "-fsized-deallocation",
    ]

    include_dirs = [
        "//",
        "$root_gen_dir",
    ]
}

config("no_stdlibs") {
    cflags_cc = [ "-nostdinc++" ]

    ldflags = [ "-nodefaultlibs" ]

    libs = [
        "c",
        "dl",
        "m",
        "pthread",
        "rt",
    ]
}

config("debug") {
    cflags = [
        "-g",
        "-O0",
    ]
}

config("release") {
    cflags = [
        "-fomit-frame-pointer",
        "-O3",
    ]

    defines = [ "NDEBUG" ]
}

config("shared_library") {
    cflags = [
        "-fPIC",
    ]
}

config("static_library") {
}

config("threads") {
    cflags = [ "-pthread" ]
    libs = [ "pthread" ]
}

config("std_string") {
    defines = [ "TSTRING_IS_STD_STRING" ]
}

config("no_custom_char_ptr_std_comparator") {
    defines = [ "NO_CUSTOM_CHAR_PTR_STD_COMPARATOR" ]
}

config("no_warnings") {
    cflags = [ "-Wno-everything" ]
}

config("no_undefined") {
    ldflags = [ "-Wl,--no-undefined" ]
}
