executable("pch_update") {
    sources = [
        "baseline.cpp",
        "common.cpp",
        "dia.cpp",
        "elf.cpp",
        "export.cpp",
        "extract.cpp",
        "facts.cpp",
        "gni.cpp",
        "job_run.cpp",
        "jobs.cpp",
        "main.cpp",
        "ninja.cpp",
        "preflight.cpp",
        "selector.cpp",
        "self_test.cpp",
        "trace.cpp",
        "workflow.cpp",
    ]
    # Executable defaults already provide platform_deps and libcxx.
    deps += [
        "//contrib/libs/lz4",
        "//contrib/libs/rapidjson",
        "//contrib/libs/zlib",
        "//contrib/libs/zstd",
    ]
    configs -= [
        "//build/gn/config:std_string",
        "//build/gn/config:ydb_embedded_nbs",
        "//build/gn/config:yql_abi",
    ]
}
