executable("pch_update") {
    sources = [
        "baseline.cpp",
        "checks.cpp",
        "common.cpp",
        "dia.cpp",
        "elf.cpp",
        "facts.cpp",
        "gni.cpp",
        "groups.cpp",
        "job_run.cpp",
        "jobs.cpp",
        "main.cpp",
        "model.cpp",
        "ninja.cpp",
        "trace.cpp",
        "two_step.cpp",
        "two_step_run.cpp",
        "two_step_test.cpp",
        "write.cpp",
    ]
    # Executable defaults already provide platform_deps and libcxx.
    deps += [ "//contrib/libs/rapidjson" ]
    configs -= [
        "//build/gn/config:std_string",
        "//build/gn/config:ydb_embedded_nbs",
        "//build/gn/config:yql_abi",
    ]
}
