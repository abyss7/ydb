# Expands @VAR@ placeholders (and #cmakedefine lines) in the given .in files.
#
# `substitutions` is a list of "KEY=VALUE" strings. They are passed on the
# action's command line (not through an intermediate file) on purpose: ninja
# re-runs an action whenever its command line changes, while an mtime-based
# dependency on a gn-generated file is not reliably propagated through the
# inputdeps phony edges.
template("expand_template") {
    assert(defined(invoker.sources), "expand_template requires `sources`")

    # By default each source is mirrored under root_gen_dir at its own repo-
    # relative path. `output_dir` overrides that with an explicit destination,
    # which is required when several targets configure the *same* .in file (the
    # SQLv1 grammar is configured by v1_antlr4, v1_ansi_antlr4 and
    # v1_proto_split_antlr4); mirroring would make them all declare the same
    # output file. ya make has the same shape — each module configures its own
    # copy into ${antlr_output}.
    _output = "{{source_gen_dir}}/{{source_name_part}}"
    if (defined(invoker.output_dir)) {
        _output = invoker.output_dir + "/{{source_name_part}}"
    }

    action_foreach(target_name) {
        forward_variables_from(invoker, [ "deps", "visibility" ])

        script = "//build/gn/scripts/expand_template.py"
        sources = invoker.sources
        outputs = [ _output ]

        args = [
            "--input", "{{source}}",
            "--output", _output,
        ]

        if (defined(invoker.substitutions)) {
            foreach(_sub, invoker.substitutions) {
                args += [ "--define", _sub ]
            }
        }
    }
}

template("library") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")

    if (defined(invoker.serialize_enum_headers)) {
        _enum_target = "${target_name}_enum"
        _output = "{{source_gen_dir}}/{{source_file_part}}_serialized.cpp"
        _header = "{{source_gen_dir}}/{{source_file_part}}_serialized.h"

        action_foreach(_enum_target) {
            script = "//build/gn/scripts/run.py"
            sources = invoker.serialize_enum_headers
            outputs = [ "$_output", "$_header" ]

            _enum_parser_bin = rebase_path("$root_out_dir/enum_parser", root_build_dir)

            args = [
                "./$_enum_parser_bin",
                "{{source}}",
                "--include-path", "{{source_root_relative_dir}}/{{source_file_part}}",
                "--output", "$_output",
                "--header", "$_header",
            ]

            deps = [ "//tools/enum_parser:enum_parser" ]
        }
    }

    # Translated sources among `sources` (//build/gn/source_kinds.gni)
    _rl6 = []
    if (defined(invoker.sources)) {
        _rl6 = filter_include(invoker.sources, [ "*.rl6" ])
    }
    if (_rl6 != []) {
        ragel6_sources("${target_name}_rl6") {
            sources = _rl6
            visibility = [ ":*" ]
        }
    }
    _y = []
    if (defined(invoker.sources)) {
        _y = filter_include(invoker.sources, [ "*.y", "*.ypp" ])
    }
    if (_y != []) {
        bison_sources("${target_name}_y") {
            sources = _y
            visibility = [ ":*" ]
        }
    }

    _has_resources = defined(invoker.resources) || defined(invoker.resource_files)
    if (_has_resources) {
        _resources_target = "${target_name}_resources"

        resources(_resources_target) {
            forward_variables_from(invoker, [ "resources", "resource_files" ])
            if (defined(invoker.resource_deps)) {
                deps = invoker.resource_deps
            }
            visibility = [ ":*" ]
        }
    }

    # Link slots, see //build/gn/link_slots.gni
    _slot_provider = defined(invoker.link_slot_provides)
    if (_slot_provider) {
        link_slot_provider_config(target_name) {
            provides = invoker.link_slot_provides
        }
    }
    _slot_weak = defined(invoker.link_slot_interface)
    if (_slot_weak) {
        link_slot_weak_refs(target_name) {
            slot = invoker.link_slot_interface
            headers = invoker.link_slot_headers
            if (defined(invoker.link_slot_flags_from)) {
                flags_from = invoker.link_slot_flags_from
            } else if (defined(invoker.sources)) {
                flags_from = invoker.sources
            }
        }
    }

    target(library_type, target_name) {
        forward_variables_from(invoker, "*", [ "configs", "deps", "resources", "resource_files", "resource_deps", "link_slot_provides", "link_slot_interface", "link_slot_headers", "link_slot_flags_from", "yql_abi_version" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = "${_unique_name}_${target_name}"

        # Append to default deps
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }

        if (_rl6 != []) {
            sources -= _rl6
            sources += get_target_outputs(":${target_name}_rl6")
            deps += [ ":${target_name}_rl6" ]
        }

        if (_y != []) {
            sources -= _y
            sources += filter_include(get_target_outputs(":${target_name}_y"), [ "*.cpp" ])
            deps += [ ":${target_name}_y" ]
            configs += [ ":${target_name}_y_config" ]
        }

        if (defined(invoker.serialize_enum_headers)) {
            deps += [
                ":$_enum_target",
                "//tools/enum_parser:runtime"
            ]
            if (!defined(sources)) {
                sources = []
            }
            sources += get_target_outputs(":$_enum_target")
        }

        if (_has_resources) {
            deps += [
                ":$_resources_target",
                "//library/cpp/resource",
            ]
            if (!defined(sources)) {
                sources = []
            }
            sources += filter_include(get_target_outputs(":$_resources_target"), [ "*.cpp" ])
        }

        # Link slots: a provider's definitions stay strong; an interface's
        # dependents get weak references, the library itself does not (it
        # defines some of the listed functions): the list is a public config,
        # which gn applies to the target too, GN_SLOT_INTERFACE_<slot> turns
        # it off here
        if (_slot_provider) {
            configs += [ ":${target_name}_slot_provider_config" ]
        }
        if (_slot_weak) {
            if (!defined(defines)) {
                defines = []
            }
            defines += [ "GN_SLOT_INTERFACE_" + invoker.link_slot_interface ]
            if (!defined(public_deps)) {
                public_deps = []
            }
            public_deps += [ ":${target_name}_slot_weak" ]
            if (!defined(public_configs)) {
                public_configs = []
            }
            public_configs += [ ":${target_name}_slot_weak_config" ]
            if (!defined(metadata)) {
                metadata = {}
            }
            metadata.link_slot_interfaces = [ invoker.link_slot_interface + "|" +
                                              get_label_info(":$target_name", "label_no_toolchain") ]
        }

        # UDF ABI: the current one by default (//build/gn/config:yql_abi_current in
        # the default configs); YQL_ABI_VERSION(M m p) in ya.make -> "M.m.p" here.
        if (defined(invoker.yql_abi_version)) {
            _abi = string_split(invoker.yql_abi_version, ".")
            configs -= [ "//build/gn/config:yql_abi_current" ]
            if (!defined(defines)) {
                defines = []
            }
            defines += [
                "UDF_ABI_VERSION_MAJOR=${_abi[0]}",
                "UDF_ABI_VERSION_MINOR=${_abi[1]}",
                "UDF_ABI_VERSION_PATCH=${_abi[2]}",
            ]
        }

        if (defined(allow_undefined) && allow_undefined == true) {
            configs -= [ "//build/gn/config:no_undefined" ]
        }

        if (enable_pch && label_matches(get_label_info(":$target_name", "label_no_toolchain"), pch_targets)) {
            precompiled_header = "pch.h"
            precompiled_source = "//build/gn/pch/$_path/$target_name.h"
            configs += [ "//build/gn/config:pch" ]
        }
    }
}
