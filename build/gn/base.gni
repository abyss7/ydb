template("library") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/unique_name.py", [ _path ], "trim string")

    target(library, target_name) {
        forward_variables_from(invoker, "*", [ "config", "deps" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = _unique_name

        # Append to default deps
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }
    }
}
