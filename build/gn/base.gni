template("expand_template") {
    assert(defined(invoker.sources), "expand_template requires `sources`")

    _output = "{{source_gen_dir}}/{{source_name_part}}"

    _has_subs = defined(invoker.substitutions)
    if (_has_subs) {
        _subs_target = "${target_name}_subs"
        _subs_file = "$target_gen_dir/${target_name}.subs.json"

        generated_file(_subs_target) {
            outputs = [ _subs_file ]
            contents = invoker.substitutions
            output_conversion = "json"
        }
    }

    action_foreach(target_name) {
        forward_variables_from(invoker, [ "deps", "visibility" ])

        script = "//build/gn/scripts/expand_template.py"
        sources = invoker.sources
        outputs = [ _output ]

        args = [
            "--input", "{{source}}",
            "--output", _output,
        ]

        if (_has_subs) {
            inputs = [ _subs_file ]
            args += [ "--defines-file", rebase_path(_subs_file, root_build_dir) ]

            if (!defined(deps)) {
                deps = []
            }
            deps += [ ":$_subs_target" ]
        }
    }
}

template("library") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")

    if (defined(invoker.serialize_enum_headers)) {
        _enum_target = "${target_name}_enum"
        _enum_config = "${target_name}_enum_config"
        _output = "{{source_gen_dir}}/{{source_name_part}}_serialized.cpp"

        config(_enum_config) {
            include_dirs = [ "." ]
        }

        action_foreach(_enum_target) {
            script = "//build/gn/scripts/run.py"
            sources = invoker.serialize_enum_headers
            outputs = [ "$_output" ]

            _enum_parser_bin = rebase_path("$root_out_dir/enum_parser", root_build_dir)

            args = [
                "./$_enum_parser_bin",
                "{{source}}",
                "--include-path", rebase_path("{{source}}", "{{source_dir}}"),
                "--output", "$_output",
            ]

            deps = [ "//tools/enum_parser:enum_parser" ]
        }
    }

    target(library_type, target_name) {
        forward_variables_from(invoker, "*", [ "configs", "deps" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = "${_unique_name}_${target_name}"

        # Append to default deps
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        # Append to default configs
        if (defined(invoker.configs)) {
           configs += invoker.configs
        }

        if (defined(invoker.serialize_enum_headers)) {
            deps += [
                ":$_enum_target",
                "//tools/enum_parser:runtime"
            ]
            if (!defined(sources)) {
                sources = []
            }
            sources += get_target_outputs(":$_enum_target")
            configs += [ ":$_enum_config" ]
        }

        if (defined(allow_undefined) && allow_undefined == true) {
            configs -= [ "//build/gn/config:no_undefined" ]
        }
    }
}
