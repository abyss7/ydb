template("protobuf_library") {
    _source_dir = rebase_path("//", root_build_dir)
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")
    _gen_target = "${_unique_name}_${target_name}_gen"

    _proto_paths = [
        "-I", rebase_path("//", root_build_dir),
        "-I", rebase_path("//contrib/libs/protobuf/src", root_build_dir),
        # "-I", rebase_path("//contrib/libs/opentelemetry-proto", root_build_dir), # TODO: it's a hack
    ]

    _protoc_bin = rebase_path("$root_out_dir/protoc", root_build_dir)
    _protoc_plugin_cpp_styleguide = "$root_out_dir/cpp_styleguide"
    _protoc_plugin_grpc_cpp = "$root_out_dir/grpc_cpp"

    action_foreach(_gen_target) {
        script = "//build/gn/scripts/protoc.py"
        sources = invoker.sources
        outputs = [
            "{{source_gen_dir}}/{{source_name_part}}.grpc.pb.cc",
            "{{source_gen_dir}}/{{source_name_part}}.grpc.pb.h",
            "{{source_gen_dir}}/{{source_name_part}}.pb.cc",
            "{{source_gen_dir}}/{{source_name_part}}.pb.h",
        ]

        args = [ _source_dir ] + outputs + ["--"] + [ "./$_protoc_bin" ] + _proto_paths
        args += [
            "--fatal_warnings",
            "--cpp_out", "$root_gen_dir",
            "--cpp_styleguide_out", "$root_gen_dir",
            "--grpc_cpp_out", "$root_gen_dir",
            "--plugin=protoc-gen-cpp_styleguide=$_protoc_plugin_cpp_styleguide",
            "--plugin=protoc-gen-grpc_cpp=$_protoc_plugin_grpc_cpp",
            "{{source}}",
        ]

        deps = [
            "//contrib/tools/protoc:protoc",
            "//contrib/tools/protoc/plugins/cpp_styleguide",
            "//contrib/tools/protoc/plugins/grpc_cpp",
        ]
    }

    library(target_name) {
        forward_variables_from(invoker, "*", [ "deps", "public_deps", "sources" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = _unique_name

        public_deps = [
            "//contrib/libs/grpc",
            "//contrib/libs/protobuf",
        ]
        if (defined(invoker.public_deps)) {
            public_deps += invoker.public_deps
        }

        # TODO: losing default deps here?
        deps = [ ":$_gen_target" ]
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        sources = get_target_outputs(":$_gen_target")
    }
}
