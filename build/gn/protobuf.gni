template("protobuf_library") {
    _source_dir = rebase_path("//", root_build_dir)
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")
    _gen_target = "${_unique_name}_${target_name}_gen"
    _proto_includes_target = "${_unique_name}_${target_name}_proto_includes"
    _proto_includes_file = "$target_gen_dir/${target_name}.proto_includes"

    _proto_paths = [
        "-I", rebase_path("//", root_build_dir),
        "-I", rebase_path("//contrib/libs/protobuf/src", root_build_dir),
        # "-I", rebase_path("//contrib/libs/opentelemetry-proto", root_build_dir), # TODO: it's a hack
    ]

    _protoc_bin = rebase_path("$root_out_dir/protoc", root_build_dir)
    _protoc_plugin_cpp_styleguide = "$root_out_dir/cpp_styleguide"
    _protoc_plugin_grpc_cpp = "$root_out_dir/grpc_cpp"

    _extra_plugins = []
    if (defined(invoker.extra_plugins)) {
        _extra_plugins = invoker.extra_plugins
    }

    # Include dirs this library both uses for its own protoc invocation and
    # advertises to consumers via metadata (`generated_file` below).
    _self_proto_paths = []
    if (defined(invoker.proto_public_include_dirs)) {
        foreach(_dir, invoker.proto_public_include_dirs) {
            _self_proto_paths += [ "-I", rebase_path(_dir, root_build_dir) ]
        }
    }

    # C++ side of the same story: when a foreign proto resolves an `import` via
    # a non-default `-I`, the corresponding `.pb.h` ends up at the long path
    # ($root_gen_dir/<full source path>/foo.pb.h), but the generated `#include`
    # uses the short form (foo.pb.h relative to that `-I`). Mirror each
    # protoc `-I` with a matching $root_gen_dir/<rel> on the C++ include path.
    _public_config_target = ""
    if (defined(invoker.proto_public_include_dirs)) {
        _public_config_target = "${target_name}_proto_public_config"
        config(_public_config_target) {
            include_dirs = []
            foreach(_dir, invoker.proto_public_include_dirs) {
                include_dirs += [ "$root_gen_dir/" + rebase_path(_dir, "//") ]
            }
        }
    }

    # Collect transitive `proto_include_dirs` metadata from all deps. Each
    # protobuf_library may declare `proto_public_include_dirs` to advertise
    # additional `-I` paths to its consumers (analogue of ya make's
    # PROTO_NAMESPACE(GLOBAL ...)).
    generated_file(_proto_includes_target) {
        outputs = [ _proto_includes_file ]
        data_keys = [ "proto_include_dirs" ]
        output_conversion = "list lines"
        deps = []
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }
        if (defined(invoker.public_deps)) {
            deps += invoker.public_deps
        }
    }

    # When `proto_public_include_dirs` is set, protoc canonicalizes the source
    # via the matching `-I` (see protoc.py:relativize_proto_sources), so the
    # output path under `--cpp_out` uses the *short* form (e.g. `google/api/x`
    # instead of `contrib/libs/foo/google/api/x`). To keep emitted files at
    # `{{source_gen_dir}}` (the long path GN expects), prepend the include dir
    # to `--cpp_out`. Assumes all sources live under the first include dir.
    _cpp_out = "$root_gen_dir"
    if (defined(invoker.proto_public_include_dirs)) {
        _public_dirs = invoker.proto_public_include_dirs
        _cpp_out = "$root_gen_dir/" + rebase_path(_public_dirs[0], "//")
    }

    action_foreach(_gen_target) {
        script = "//build/gn/scripts/protoc.py"
        sources = invoker.sources
        inputs = [ _proto_includes_file ]
        outputs = [
            "{{source_gen_dir}}/{{source_name_part}}.grpc.pb.cc",
            "{{source_gen_dir}}/{{source_name_part}}.grpc.pb.h",
            "{{source_gen_dir}}/{{source_name_part}}.pb.cc",
            "{{source_gen_dir}}/{{source_name_part}}.pb.h",
        ]

        args = [ _source_dir ] + outputs + ["--"] + [ "./$_protoc_bin" ] + _proto_paths + _self_proto_paths
        args += [
            "--fatal_warnings",
            "--cpp_out", _cpp_out,
            "--cpp_styleguide_out", _cpp_out,
            "--grpc_cpp_out", _cpp_out,
            "--plugin=protoc-gen-cpp_styleguide=$_protoc_plugin_cpp_styleguide",
            "--plugin=protoc-gen-grpc_cpp=$_protoc_plugin_grpc_cpp",
            "--proto-include-paths-file", rebase_path(_proto_includes_file, root_build_dir),
        ]

        deps = [
            ":$_proto_includes_target",
            "//contrib/tools/protoc:protoc",
            "//contrib/tools/protoc/plugins/cpp_styleguide",
            "//contrib/tools/protoc/plugins/grpc_cpp",
        ]

        foreach(_plugin, _extra_plugins) {
            args += [
                "--plugin=protoc-gen-${_plugin.name}=$root_out_dir/${_plugin.name}",
                "--${_plugin.name}_out", _cpp_out,
            ]
            deps += [ _plugin.target ]
        }

        args += [ "{{source}}" ]
    }

    # Opt-in enum serialization for proto enums, analogous to the `library`
    _enum_targets = []
    _enum_sources = []
    if (defined(invoker.serialize_enum_headers)) {
        _enum_idx = 0
        foreach(_header, invoker.serialize_enum_headers) {
            _gen_header = "$target_gen_dir/$_header"
            _enum_t = "${_unique_name}_${target_name}_enum_${_enum_idx}"
            _enum_out = "$target_gen_dir/" + get_path_info(_header, "name") + "_serialized.cpp"

            action(_enum_t) {
                script = "//build/gn/scripts/run.py"
                inputs = [ _gen_header ]
                outputs = [ _enum_out ]

                _enum_parser_bin = rebase_path("$root_out_dir/enum_parser", root_build_dir)

                args = [
                    "./$_enum_parser_bin",
                    rebase_path(_gen_header, root_build_dir),
                    "--include-path", rebase_path(_gen_header, root_gen_dir),
                    "--output", rebase_path(_enum_out, root_build_dir),
                ]

                deps = [
                    ":$_gen_target",
                    "//tools/enum_parser:enum_parser",
                ]
            }

            _enum_targets += [ ":$_enum_t" ]
            _enum_sources += [ _enum_out ]
            _enum_idx += 1
        }
    }

    library(target_name) {
        forward_variables_from(invoker, "*", [ "deps", "public_configs", "public_deps", "sources", "extra_plugins", "proto_public_include_dirs", "serialize_enum_headers" ])

        output_dir = "$root_out_dir/" + rebase_path(".", "//") # TODO: doesn't work for some reason
        output_name = _unique_name

        public_deps = [
            "//contrib/libs/grpc",
            "//contrib/libs/protobuf",
        ]
        if (defined(invoker.public_deps)) {
            public_deps += invoker.public_deps
        }

        # TODO: losing default deps here?
        deps = [ ":$_gen_target" ]
        deps += _enum_targets
        if (_enum_targets != []) {
            deps += [ "//tools/enum_parser:runtime" ]
        }
        if (defined(invoker.deps)) {
            deps += invoker.deps
        }

        public_configs = []
        if (defined(invoker.public_configs)) {
            public_configs += invoker.public_configs
        }
        if (_public_config_target != "") {
            # Self: own .pb.cc files need the include path too (their .pb.h
            # imports siblings via the short form). Public: consumers compiling
            # against this library inherit it via public_deps.
            public_configs += [ ":$_public_config_target" ]
        }

        # Expose this library's own protoc include paths (if any) and its
        # transitive ones so downstream consumers pick them up via metadata walk.
        metadata = {
            proto_include_dirs = []
            if (defined(invoker.proto_public_include_dirs)) {
                foreach(_dir, invoker.proto_public_include_dirs) {
                    proto_include_dirs += [ rebase_path(_dir, root_build_dir) ]
                }
            }
        }

        sources = get_target_outputs(":$_gen_target") + _enum_sources
    }
}
