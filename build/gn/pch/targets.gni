pch_targets = [
  "//ydb/core/cms/console:console",
  "//ydb/core/grpc_services:grpc_services",
  "//ydb/core/kqp/opt:opt",
  "//ydb/core/mind/bscontroller:bscontroller",
  "//ydb/core/mind/hive:hive",
  "//ydb/core/tx/columnshard:columnshard",
  "//ydb/core/tx/datashard:datashard",
  "//ydb/core/tx/schemeshard:schemeshard",
  "//ydb/core/ymq/actor:actor",
]

# the precompiled header of contrib (//build/gn/pch:contrib, the C++ standard
# library) instead of the global one: contrib/, what is contrib by its code,
# the code bases below ydb that its headers clash with, the targets defining
# specializations (Out<> ...) the global one instantiates
contrib_pch_targets = [
  "//contrib/*",
  "//ydb/core/protos:protos",
  "//ydb/library/yql/udfs/common/clickhouse/*",
  "//util/*",
  "//yql/essentials/*",
  "//yt/*",
]

contrib_pch_exclude = [
  "//contrib/libs/farmhash:*",
  "//contrib/libs/jemalloc:*",
  "//contrib/libs/tbb:*",
  "//yql/essentials/parser/pg_wrapper/*",
  "//yt/yt/core:*",
]

global_pch_exclude = [
  "//library/cpp/digest/argonish/internal/proxies:avx2",
  "//ydb/library/arrow_clickhouse/*",
  "//ydb/library/yql/dq/comp_nodes/hash_join_utils/simd/exec/pack_tuple:*",
  "//ydb/library/yql/dq/comp_nodes/hash_join_utils/simd/exec/runtime_dispatching:AVX2_algo",
  "//ydb/library/yql/dq/comp_nodes/hash_join_utils:*",
]
