import("//build/gn/pch/global/pch_flags.gni")

template("shared_pch") {
  _name = target_name
  _compile = "${_name}_compile"
  _object = get_path_info(invoker.source, "out_dir") + "/$_compile." +
            get_path_info(invoker.source, "file") + ".o"
  _pch = "$target_gen_dir/$_name.pch"
  if (defined(invoker.parent)) {
    _parent_pch = "$target_gen_dir/pch_${invoker.parent}.pch"
    _parent_target = ":pch_${invoker.parent}_pch"
  }
  _pch_root = [
    "-isysroot",
    string_replace(string_replace(rebase_path("//.") + "/", "/./", "/"), "//", "/"),
  ]

  config("${_name}_private_config") {
    visibility = [ ":*" ]
    cflags = [ "-w" ]
  }

  config("${_name}_group_config") {
    visibility = [ ":*" ]
    defines = invoker.defines
    include_dirs = invoker.include_dirs
  }

  # Generated layouts carry the exact compiler class. Keep generator and
  # runtime public configs behind a private dependency boundary.
  group("${_name}_inputs") {
    visibility = [ ":*" ]
    deps = platform_deps + [ "//contrib/libs/cxxsupp/libcxx" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
  }

  source_set(_compile) {
    visibility = [ ":*" ]
    sources = [ invoker.source ]
    deps = []
    cflags_cc = pch_only_cflags + _pch_root
    if (defined(invoker.parent)) {
      # GN target deps order the parent build; inputs also make an unchanged
      # delta source recompile when its parent PCH bytes change.
      deps = [ _parent_target ]
      inputs = [ _parent_pch ]
      cflags_cc += [
        "-include-pch",
        rebase_path(_parent_pch, root_build_dir),
      ]
    }
    if (defined(invoker.cflags)) {
      cflags = invoker.cflags
    }
    configs += [
      ":${_name}_private_config",
      ":${_name}_group_config",
    ]
    deps += platform_deps + [ "//contrib/libs/cxxsupp/libcxx" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
    if (defined(invoker.compiler_flags)) {
      configs = []
      cflags = invoker.compiler_flags
      deps = []
      deps = [ ":${_name}_inputs" ]
      if (defined(invoker.parent)) {
        deps += [ _parent_target ]
      }
    }
  }

  copy("${_name}_pch") {
    visibility = [ ":*" ]
    sources = [ _object ]
    outputs = [ _pch ]
    deps = [ ":$_compile" ]
  }

  action("${_name}_check") {
    visibility = [ ":*" ]
    script = "//build/gn/scripts/pch_check.py"
    inputs = [ invoker.source ]
    outputs = [ "$target_gen_dir/$_name.check.stamp" ]
    depfile = "$target_gen_dir/$_name.check.d"
    args = [
      "--compile-commands",
      "compile_commands.json",
      "--root",
      rebase_path("//", root_build_dir),
      "--pch",
      rebase_path(_pch, root_build_dir),
      "--source",
      rebase_path(invoker.source, "//"),
      "--stamp",
      rebase_path(outputs[0], root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),
    ]
    deps = [ ":${_name}_pch" ]
  }

  config("${_name}_config") {
    visibility = [ ":*" ]
    cflags_cc = [
      "-include-pch",
      rebase_path(_pch, root_build_dir),
      # Include all ancestors in direct-build depfiles too. A delta can remain
      # byte-identical when only its parent's serialized macro state changes.
      "-Xclang",
      "-module-file-deps",
    ] + _pch_root
  }

  group(_name) {
    public_deps = [ ":${_name}_pch" ]
    data_deps = [ ":${_name}_check" ]
    public_configs = [ ":${_name}_config" ]
  }
}

foreach(_group, pch_groups) {
  shared_pch("pch_${_group.name}") {
    source = "${_group.name}/pch.cc"
    deps = _group.deps
    cflags = _group.cflags
    defines = _group.defines
    include_dirs = _group.include_dirs
    if (defined(_group.compiler_flags)) {
      compiler_flags = _group.compiler_flags
    }
    if (defined(_group.parent)) {
      parent = _group.parent
    }
  }
}
