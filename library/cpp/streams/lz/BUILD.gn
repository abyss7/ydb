config("lz_private_config") {
  defines = [ "OPENSOURCE" ]
}

library("lz") {
  public_deps = [
    ":lz4",
    ":snappy",
  ]

  deps = [
    "//contrib/libs/fastlz",
  ]

  sources = [ "lz.cpp" ]

  configs = [ ":lz_private_config" ]
}

library("lz4") {
  public_deps = [
    "//contrib/libs/lz4",
  ]

  sources = [ "lz4/lz4.cpp" ]
}

library("snappy") {
  public_deps = [
    "//contrib/libs/snappy",
  ]

  sources = [ "snappy/snappy.cpp" ]
}
