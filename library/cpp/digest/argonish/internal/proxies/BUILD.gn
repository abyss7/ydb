config("avx2_config") {
    cflags = [ "-mavx2", "-mfma", "-mbmi", "-mbmi2" ]
}

config("sse2_config") {
    cflags = [ "-msse2" ]
}

config("sse41_config") {
    cflags = [ "-msse4.1" ]
}

config("ssse3_config") {
    cflags = [ "-mssse3" ]
}

library("avx2") {
    deps = [ "//library/cpp/threading/poor_man_openmp" ]
    sources = [ "avx2/proxy_avx2.cpp" ]
    configs = [ ":avx2_config" ]
}

library("ref") {
    deps = [ "//library/cpp/threading/poor_man_openmp" ]
    sources = [ "ref/proxy_ref.cpp" ]
}

library("sse2") {
    deps = [ "//library/cpp/threading/poor_man_openmp" ]
    sources = [ "sse2/proxy_sse2.cpp" ]
    configs = [ ":sse2_config" ]
}

library("sse41") {
    deps = [ "//library/cpp/threading/poor_man_openmp" ]
    sources = [ "sse41/proxy_sse41.cpp" ]
    configs = [ ":sse41_config" ]
}

library("ssse3") {
    deps = [ "//library/cpp/threading/poor_man_openmp" ]
    sources = [ "ssse3/proxy_ssse3.cpp" ]
    configs = [ ":ssse3_config" ]
}

group("proxies") {
    public_deps = [
        ":avx2",
        ":ref",
        ":sse2",
        ":sse41",
        ":ssse3",
    ]
}
