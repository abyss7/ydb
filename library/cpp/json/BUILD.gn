library("common") {
  sources = [ "common/defs.cpp" ]
}

library("easy_parse") {
  deps = [ ":json" ]

  sources = [ "easy_parse/json_easy_parser.cpp" ]
}

library("fast_sax") {
  public_deps = [
    # ":common",
  ]

  sources = [
    "fast_sax/parser.rl6",
    "fast_sax/unescape.cpp",
  ]
}

library("json") {
  public_deps = [
    ":common",
    ":fast_sax",
  ]

  deps = [
    "//contrib/libs/rapidjson",
    # "//library/cpp/string_utils/relaxed_escaper",
  ]

  sources = [
    "json_prettifier.cpp",
    "json_reader.cpp",
    "json_writer.cpp",
    "rapidjson_helpers.cpp",
    "writer/json.cpp",
    "writer/json_value.cpp",
  ]

  serialize_enum_headers = [ "writer/json_value.h" ]
}

library("yson") {
  public_deps = [
    ":json",
    "//library/cpp/yson",
  ]

  deps = [ "//library/cpp/yson:json" ]

  sources = [ "yson/json2yson.cpp" ]
}
