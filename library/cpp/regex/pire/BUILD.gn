# yamake2gn: keep  -- hand-written, do not regenerate

import("//build/gn/bison.gni")

config("public_config") {
  cflags = [
    "-Wno-deprecated-anon-enum-enum-conversion",
    "-Wno-unused-but-set-variable",
  ]
}

bison_source_set("re_parser") {
  sources = [ "pire/re_parser.y" ]
  configs = [ ":public_config" ]
}

library("pire") {
  public_deps = [
    "//library/cpp/charset",
  ]
  deps = [ ":re_parser" ]

  sources = [
    "extraencodings.cpp",
    "pcre2pire.cpp",
    "pire/approx_matching.cpp",
    "pire/classes.cpp",
    "pire/easy.cpp",
    "pire/encoding.cpp",
    "pire/extra/capture.cpp",
    "pire/extra/count.cpp",
    "pire/extra/glyphs.cpp",
    "pire/fsm.cpp",
    "pire/half_final_fsm.cpp",
    "pire/re_lexer.cpp",
    "pire/read_unicode.cpp",
    "pire/scanner_io.cpp",
    "pire/scanners/null.cpp",
  ]

  public_configs = [ ":public_config" ]
}
