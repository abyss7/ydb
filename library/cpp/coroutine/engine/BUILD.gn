# yamake2gn: keep  -- hand-written, do not regenerate

config("private_config") {
  cflags = [ "-Wno-logical-op-parentheses" ]
}

library("engine") {
  public_deps = [ "//library/cpp/containers/intrusive_rb_tree" ]

  sources = [
    "cont_poller.cpp",
    "helper.cpp",
    "impl.cpp",
    "iostatus.cpp",
    "network.cpp",
    "poller.cpp",
    "sockpool.cpp",
    "stack/stack.cpp",
    "stack/stack_allocator.cpp",
    "stack/stack_guards.cpp",
    "stack/stack_storage.cpp",
    "stack/stack_utils.cpp",
    "trampoline.cpp",
  ]

  serialize_enum_headers = [
    "poller.h",
    "stack/stack_common.h",
  ]

  configs = [ ":private_config" ]
}
