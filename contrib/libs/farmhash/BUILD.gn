config("public_config") {
    include_dirs = [ "include" ]
}

config("private_config") {
    cflags = [ "-Wno-unused-function" ]
}

contrib_library("farmhash") {
    deps = [
        ":sse41",
        ":sse42",
        ":sse42_aesni",
    ]

    sources = [
        "farmhash_iface.cc",
        "farmhashcc.cc",
        "farmhashmk.cc",
        "farmhashna.cc",
        "farmhashuo.cc",
        "farmhashxo.cc",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}

sse41_source_set("sse41") {
    sources = [ "farmhashnt.cc" ]
    configs = [ ":private_config" ]
}

sse42_source_set("sse42") {
    sources = [
        "farmhashsa.cc",
        "farmhashte.cc",
    ]

    configs = [ ":private_config" ]
}

sse42_source_set("sse42_aesni") {
    sources = [ "farmhashsu.cc" ]
    configs = [ ":private_config" ]
}
