config("public_config") {
    include_dirs = [
        ".",
        "base",
    ]
}

config("private_config") {
    defines = [
        "__POPCNT__",
        "__SSE2__",
    ]
}

library("arrow_clickhouse") {
    deps = [
        "//contrib/libs/apache/arrow",
        "//contrib/restricted/cityhash-1.0.2",
    ]

    sources = [
        "AggregateFunctions/IAggregateFunction.cpp",
        "Aggregator.cpp",
        "Columns/ColumnAggregateFunction.cpp",
        "Columns/ColumnsCommon.cpp",
        "Common/Allocator.cpp",
        "Common/PODArray.cpp",
        "DataStreams/AggregatingBlockInputStream.cpp",
        "DataStreams/IBlockInputStream.cpp",
        "DataStreams/MergingAggregatedBlockInputStream.cpp",
        "base/common/mremap.cpp",
    ]

    public_configs = [ ":public_config" ]
    configs = [ ":private_config" ]
}
