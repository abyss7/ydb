library("mon") {
  public_deps = [ "//library/cpp/monlib/service" ]

  deps = [
    ":schemu",
    # "//library/cpp/html/pcdata",
    # "//library/cpp/monlib/dynamic_counters",  # peerdir only
    "//library/cpp/monlib/service/pages",
    # "//library/cpp/resource",
  ]

  sources = [ "mon/mon.cpp" ]

  resources = [
    {
      path = "mon/static/css/bootstrap.min.css"
      key = "schlab/css/bootstrap.min.css"
    },
    {
      path = "mon/static/css/scharm.css"
      key = "schlab/css/scharm.css"
    },
    {
      path = "mon/static/css/schviz.css"
      key = "schlab/css/schviz.css"
    },
    {
      path = "mon/static/js/jquery.min.js"
      key = "schlab/js/jquery.min.js"
    },
    {
      path = "mon/static/js/bootstrap.min.js"
      key = "schlab/js/bootstrap.min.js"
    },
    {
      path = "mon/static/js/d3-tip-0.8.0-alpha.1.js"
      key = "schlab/js/d3-tip-0.8.0-alpha.1.js"
    },
    {
      path = "mon/static/js/d3.v4.min.js"
      key = "schlab/js/d3.v4.min.js"
    },
    {
      path = "mon/static/js/scharm.js"
      key = "schlab/js/scharm.js"
    },
    {
      path = "mon/static/js/schviz.js"
      key = "schlab/js/schviz.js"
    },
    {
      path = "mon/static/js/scharm-test0.js"
      key = "schlab/js/scharm-test0.js"
    },
    {
      path = "mon/static/scharm.html"
      key = "schlab/scharm.html"
    },
  ]
}

library("probes") {
  public_deps = [ "//library/cpp/lwtrace" ]

  sources = [ "probes/probes.cpp" ]
}

protobuf_library("protos") {
  sources = [ "protos/schlab.proto" ]
}

library("schemu") {
  public_deps = [
    ":schine",
    ":schoot",
  ]

  sources = [ "schemu/schemu.cpp" ]
}

library("schine") {
  deps = [
    ":probes",
    # "//library/cpp/containers/stack_vector",  # peerdir only
    "//library/cpp/lwtrace",
    "//library/cpp/lwtrace/mon",
  ]

  sources = [
    "schine/cbs.cpp",
    "schine/cbs_bin.cpp",
    "schine/cbs_state.cpp",
    "schine/job.cpp",
    "schine/job_kind.cpp",
    "schine/job_state.cpp",
    "schine/scheduler.cpp",
    "schine/schlog.cpp",
  ]
}

library("schlab") {
  deps = [
    # ":schine",  # peerdir only
  ]

  sources = [ "schlab_actor.cpp" ]
}

library("schoot") {
  deps = [
    ":protos",
    # "//contrib/libs/protobuf",
    # "//library/cpp/containers/stack_vector",  # peerdir only
    "//library/cpp/protobuf/json",
  ]

  sources = [
    "schoot/schoot_gen.cpp",
    "schoot/schoot_gen_cfg.cpp",
  ]
}
