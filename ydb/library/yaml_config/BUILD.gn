protobuf_library("protos") {
  public_deps = [
    "//ydb/core/config/protos",
    "//ydb/core/protos",
    "//ydb/library/actors/protos",
  ]

  sources = [
    "protos/blobstorage_config.proto",
    "protos/config.proto",
  ]

  extra_plugins = [
    {
      name = "config_proto_plugin"
      target = "//ydb/core/config/tools/protobuf_plugin:config_proto_plugin"
    },
  ]
}

library("public") {
  public_deps = [
    "//contrib/libs/openssl",
    "//ydb/library/actors/core",
    "//ydb/library/fyamlcpp",
  ]

  deps = [
    # "//contrib/libs/protobuf",  # peerdir only
    # "//contrib/libs/yaml-cpp",  # peerdir only
    # "//library/cpp/protobuf/json",  # peerdir only
  ]

  sources = [ "public/yaml_config.cpp" ]
}

library("yaml_config") {
