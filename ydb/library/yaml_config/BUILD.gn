    ":protos",
    ":public",
    # "//contrib/libs/openssl",
    # "//contrib/libs/protobuf",
    "//library/cpp/json",
    "//library/cpp/protobuf/json",
    "//library/cpp/streams/zstd",
    "//library/cpp/yaml/as",
    "//ydb/core/base",
    "//ydb/core/erasure",
    # "//ydb/core/protos",
    # "//ydb/library/actors/core",
    "//ydb/library/fyamlcpp",
    # "//ydb/public/api/protos",
    # "//yql/essentials/public/issue",
  ]

  deps = [
    # "//contrib/libs/xxhash",
    "//ydb/core/cms/console:util",
    "//ydb/core/config/validation",
    # "//ydb/core/viewer:json",
    # "//ydb/library/pdisk_io:device_type",
    "//ydb/library/yaml_json",
  ]

  sources = [
    "console_dumper.cpp",
    "serialize_deserialize.cpp",
    "yaml_config.cpp",
    "yaml_config_helpers.cpp",
    "yaml_config_parser.cpp",
  ]
