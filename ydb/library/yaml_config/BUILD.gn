protobuf_library("protos") {
    extra_plugins = [
        {
            name = "config_proto_plugin"
            target = "//ydb/core/config/tools/protobuf_plugin:config_proto_plugin"
        },
    ]

    deps = [
        "//ydb/core/protos",
    ]

    sources = [
        "protos/blobstorage_config.proto",
        "protos/config.proto",
    ]
}

library("yaml_config") {
    public_deps = [
        "//contrib/libs/openssl",
        "//library/cpp/yaml",
    ]

    deps = [
        ":protos",
        "//library/cpp/json",
        "//ydb/core/base",
        "//ydb/core/protos",
        "//ydb/library/actors/core",
        "//ydb/library/fyamlcpp",
    ]

    sources = [
        "console_dumper.cpp",
        "serialize_deserialize.cpp",
        "yaml_config_helpers.cpp",
        "yaml_config_parser.cpp",
        "yaml_config.cpp",
    ]
}
