unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/library/yql/providers/solomon/common",
    "//ydb/library/yql/providers/solomon/expr_nodes",
    "//ydb/library/yql/providers/solomon/provider",
    "//yql/essentials/core/project_settings",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "yql_solomon_write_settings_ut.cpp" ]

  include_dirs = [ "//ydb/library/yql/providers/solomon/provider" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
