# yamake2gn: keep  -- hand-written, do not regenerate

library("sqs_json") {
  deps = [
    "//contrib/libs/aws-sdk-cpp/aws-cpp-sdk-sqs",
    "//library/cpp/string_utils/url",
  ]

  sources = [ "sqs_json/sqs_json_client.cpp" ]
}

# sqs_workload's commands are compiled inside //ydb/public/lib/ydb_cli/commands:
# they derive from TYdbSimpleCommand and use ydb_workload.h, while that target's
# ydb_workload.cpp creates them -- mutually dependent, with that target as the
# only user. :sqs_json above does not touch it and stays a standalone library.
group("sqs_workload") {
  public_deps = [ "//ydb/public/lib/ydb_cli/commands" ]
}
