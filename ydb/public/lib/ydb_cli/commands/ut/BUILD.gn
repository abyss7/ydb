unittest_executable("ut") {
  deps = [
    "//contrib/libs/grpc",
    "//library/cpp/getopt/small",
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//library/cpp/threading/future",
    "//ydb/public/api/grpc/draft",
    "//ydb/public/lib/ydb_cli/commands",
    "//ydb/public/lib/ydb_cli/common",
    "//ydb/public/sdk/cpp/src/client/types/credentials",
  ]

  sources = [
    "bridge_ut.cpp",
    "completion_ut.cpp",
    "oidc_credentials_ut.cpp",
  ]

  include_dirs = [ "//ydb/public/lib/ydb_cli/commands" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
