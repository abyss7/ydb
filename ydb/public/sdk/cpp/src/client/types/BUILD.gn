        ":exceptions",
    ]

    sources = [
        "fatal_error_handlers/handlers.cpp",
    ]
}

library("status") {
    deps = [
        ":exceptions",
        ":fatal_error_handlers",
        "//ydb/public/api/protos",
        "//ydb/public/sdk/cpp/src/client/impl/internal:plain_status",
        "//ydb/public/sdk/cpp/src/library/issue",
    ]

    sources = [
        "status/status.cpp",
    ]

    serialize_enum_headers = [
        "//ydb/public/sdk/cpp/include/ydb-cpp-sdk/client/types/status_codes.h",
    ]
}
