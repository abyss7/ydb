library("export") {
    public_deps = [
        "//ydb/core/tx/datashard",
    ]

    sources = [
        "export/export.cpp",
    ]
}

linked_executable("ydbd") {
    link_select = [
        "YqlServicePolicy=exception_policy",
        "allocator=tcmalloc",
        "yql_pg_runtime=pg_wrapper",
    ]

    deps = [
        ":export",
        "//ydb/core/driver_lib:run",
        "//ydb/core/http_proxy",
        "//ydb/core/security",
        "//ydb/core/security:token_manager",
        "//ydb/core/transfer",
        "//ydb/core/ymq/actor",
        "//ydb/library/pdisk_io",
    ]

    sources = [ "main.cpp" ]
}
