linked_executable("bridge_skipper") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/logger",
    "//library/cpp/monlib/dynamic_counters",
    "//library/cpp/svnversion",
    "//ydb/apps/bridge_skipper/config",
    "//ydb/apps/bridge_skipper/http",
    "//ydb/apps/bridge_skipper/runtime",
    "//ydb/library/actors/core",
    "//ydb/library/actors/http",
    "//ydb/library/actors/interconnect/poller",
    "//ydb/library/actors/struct_log",
  ]

  sources = [ "main.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
