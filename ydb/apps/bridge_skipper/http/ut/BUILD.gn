unittest_executable("ut") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/monlib/encode/prometheus",  # peerdir only
    "//library/cpp/testing/unittest",
    "//ydb/apps/bridge_skipper/http",
    "//ydb/apps/bridge_skipper/runtime",
    "//ydb/library/actors/http",
    "//ydb/library/actors/testlib",
  ]

  sources = [
    "commands_ut.cpp",
    "http_ut.cpp",
  ]

  include_dirs = [ "//ydb/apps/bridge_skipper/http" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
