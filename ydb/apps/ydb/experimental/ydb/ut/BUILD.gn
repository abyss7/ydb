unittest_executable("ut") {
  deps = [
    "//contrib/libs/fmt",
    "//contrib/libs/grpc",
    "//contrib/libs/jwt-cpp",  # peerdir only
    "//library/cpp/json",
    "//library/cpp/testing/common",
    "//library/cpp/testing/unittest",
    "//ydb/core/security/certificate_check/test_utils",
    "//ydb/public/api/client/yc_public/iam",
    "//ydb/public/api/grpc",
    "//ydb/public/api/grpc/draft",
    "//ydb/public/api/protos",
    "//ydb/public/sdk/cpp/src/client/draft",
    "//ydb/public/sdk/cpp/tests/unit/client/oauth2_token_exchange/helpers",
  ]

  data_deps = [ "//ydb/apps/ydb/experimental/ydb" ]

  sources = [
    "//ydb/apps/ydb/ut/mock_env.cpp",
    "//ydb/apps/ydb/ut/run_ydb.cpp",
    "reassign_tablets.cpp",
  ]

  link_select = [ "allocator=tcmalloc" ]
}
