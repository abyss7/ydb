unittest_executable("ut") {
  deps = [
    "//library/cpp/logger",
    "//library/cpp/testing/unittest",
    "//ydb/core/fq/libs/config",
    "//ydb/core/fq/libs/test_connection",
    "//ydb/core/fq/libs/test_connection:events",
    "//ydb/core/testlib",  # peerdir only
    "//ydb/core/testlib/actors",
    "//ydb/core/testlib/basics",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "test_connection_ut.cpp" ]

  include_dirs = [ "//ydb/core/fq/libs/test_connection" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
