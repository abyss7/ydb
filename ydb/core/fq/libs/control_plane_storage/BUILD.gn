# util.cpp — набор свободных функций-хелперов над статусами/конфигом FQ
# (IsTerminalStatus и т.п.), включает только util.h и две утилиты из util/.
# Нужен grpc_services (ydb_over_fq/rpc_base.h:148,179 зовёт NFq::IsTerminalStatus),
# которому весь control_plane_storage ни к чему — иначе цикл
# grpc_services -> control_plane_storage -> quota_manager -> fq/libs/ydb
# -> query_actor -> grpc_services.
library("util") {
  public_deps = [
    "//ydb/core/fq/libs/common",
    "//ydb/core/fq/libs/config:protos",
    "//ydb/library/yql/dq/actors:protos",
    "//ydb/public/sdk/cpp/src/client/value",
    ":events",
  ]

  sources = [ "util.cpp" ]
}
