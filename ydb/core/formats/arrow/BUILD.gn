library("arrow") {
    deps = [
        ":common",
        ":serializer",
        "//ydb/core/kqp/common:arrow",
        "//ydb/core/scheme",
        "//ydb/library/conclusion",
        "//ydb/library/formats/arrow",
        "//yql/essentials/types:binary_json",
        "//yql/essentials/types:dynumber",
    ]

    sources = [
        "arrow_batch_builder.cpp",
        "arrow_filter.cpp",
        "arrow_helpers_minikql.cpp",
        "arrow_helpers.cpp",
        "converter.cpp",
        "converter.h",
        "permutations.cpp",
        "process_columns.cpp",
        "size_calcer.cpp",
        "special_keys.cpp",
    ]
}

source_set("common") {
    public_deps = [ "accessor:abstract" ]

    sources = [
        "common/adapter.cpp",
        "common/container.cpp",
    ]
}

library("serializer") {
    deps = [
        "//contrib/libs/apache/arrow",
        "//ydb/core/protos",
        "//ydb/services/bg_tasks:abstract",
    ]

    sources = [
        "serializer/abstract.cpp",
        "serializer/native.cpp",
        "serializer/parsing.cpp",
        "serializer/stream.cpp",
        "serializer/utils.cpp",
    ]
}
