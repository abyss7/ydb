unittest_executable("ut") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/testing/unittest",
    "//ydb/core/kqp/query_plan",
    "//ydb/core/protos",
    "//ydb/library/yql/dq/actors/protos",
  ]

  sources = [ "query_plan_ut.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
