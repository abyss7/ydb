library("rbo_resources") {
  resources = [
    {
      path = "//ydb/library/benchmarks/gen_queries/consts.yql"
      key = "consts.yql"
    },
    {
      path = "//ydb/library/benchmarks/gen_queries/consts_decimal.yql"
      key = "consts_decimal.yql"
    },
  ]
}

unittest_executable("rbo") {
  deps = [
    ":rbo_resources",
    "//library/cpp/random_provider",
    "//library/cpp/resource",  # peerdir only
    "//library/cpp/testing/unittest",
    "//library/cpp/time_provider",
    "//ydb/core/kqp",  # peerdir only
    "//ydb/core/kqp/common",
    "//ydb/core/kqp/opt/rbo",
    "//ydb/core/kqp/provider",
    "//ydb/core/kqp/ut/common",
    "//ydb/core/kqp/ut/olap/helpers",  # peerdir only
    "//ydb/core/statistics:ut_common",  # peerdir only
    "//ydb/library/benchmarks/queries/tpch",  # peerdir only
    "//ydb/library/plan2svg",  # peerdir only
    "//ydb/library/yql/udfs/statistics_internal",  # peerdir only
    "//ydb/public/lib/ut_helpers",  # peerdir only
    "//yql/essentials/core",
    "//yql/essentials/minikql",
    "//yql/essentials/minikql/invoke_builtins",
    "//yql/essentials/parser/pg_wrapper",
    "//yql/essentials/public/udf/service/exception_policy",  # peerdir only
    "//yql/essentials/sql/pg",  # peerdir only
    "//yql/essentials/udfs/common/digest",  # peerdir only
    "//yql/essentials/udfs/common/hyperloglog",  # peerdir only
    "//yql/essentials/udfs/common/url_base",  # peerdir only
  ]

  sources = [
    "kqp_rbo_copy_ut.cpp",
    "kqp_rbo_global_ut.cpp",
  ]

  include_dirs = [
    "//ydb/core/kqp",  # peerdir only
  ]

  data = [
    "//ydb/core/kqp/ut/join/data/",
    "data/",
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg",
    "yt_codegen=llvm16",
  ]
}
