unittest_executable("correctness") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/testing/common",
    "//ydb/core/kqp",  # peerdir only
    "//ydb/core/kqp/ut/common",
    "//ydb/core/kqp/ut/rbo/statistics/helpers",
    "//yql/essentials/parser/pg_wrapper",
    "//yql/essentials/sql/pg",  # peerdir only
  ]

  data_deps = [ "//ydb/apps/ydb" ]

  sources = [ "kqp_analyzed_correctness_ut.cpp" ]

  include_dirs = [
    "//ydb/core/kqp",  # peerdir only
  ]

  data = [
    "//ydb/core/kqp/ut/rbo/data/yql-tpcds/",
    "//ydb/core/kqp/ut/rbo/data/yql-tpch/",
    "//ydb/core/kqp/ut/rbo/statistics/data/",
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_wrapper",
    "yql_pg_sql_translator=pg",
    "yt_codegen=llvm16",
  ]
}
