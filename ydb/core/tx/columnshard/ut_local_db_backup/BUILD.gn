unittest_executable("ut_local_db_backup") {
  deps = [
    "//library/cpp/json",
    "//library/cpp/testing/hook",
    "//library/cpp/testing/unittest",
    "//ydb/core/tablet_flat",
    "//ydb/core/testlib",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx/columnshard",
    "//ydb/core/tx/columnshard/hooks/testing",  # peerdir only
    "//ydb/core/tx/columnshard/test_helper",
    "//ydb/core/wrappers:ut_helpers",
    "//ydb/library/aclib",
    "//ydb/library/actors/core",
    "//ydb/library/actors/protos",
    "//ydb/library/aws_init",
  ]

  sources = [ "ut_local_db_backup.cpp" ]

  include_dirs = [ "//ydb/core/tx/columnshard" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
