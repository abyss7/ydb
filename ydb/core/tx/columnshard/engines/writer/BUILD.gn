# No dep on //ydb/core/tx/columnshard: actor2.cpp includes columnshard_impl.h
# but never touches TColumnShard or anything defined in the tablet's own
# sources, and events.h needs only the header-only TEvPrivate ids. The tablet
# creates this actor (columnshard.cpp), so a dep back on it closes a cycle.
library("buffer") {
  public_deps = [
    "//ydb/core/formats/arrow",
    "//ydb/core/tx/columnshard/common",
    "//ydb/core/tx/columnshard/engines/writer",
    "//ydb/core/tx/columnshard/operations",
    "//ydb/core/tx/columnshard/operations:common",
    "//ydb/core/tx/columnshard/operations:slice_builder",
    "//ydb/core/tx/data_events",
    "//ydb/library/actors/core",
    "//ydb/library/actors/testlib/common",
  ]

  deps = [
    "//ydb/core/base",
    "//ydb/core/tx/columnshard/blobs_action:abstract",
    "//ydb/core/tx/conveyor/usage",
    "//ydb/core/tx/conveyor_composite/usage",
    # Providers of headers pulled in via columnshard_private_events.h, generated
    # ones included; previously they arrived only through the tablet.
    "//ydb/core/protos",
    "//ydb/core/tx/columnshard/counters",
    "//ydb/core/tx/columnshard/engines",
  ]

  sources = [
    "buffer/actor2.cpp",
    "buffer/events.cpp",
  ]
}

library("writer") {
  public_deps = [
    # "//ydb/core/formats/arrow",
    "//ydb/core/protos",
    # "//ydb/core/tx/columnshard",
    "//ydb/core/tx/columnshard/blobs_action:abstract",
    "//ydb/core/tx/columnshard/blobs_action:counters",
    "//ydb/core/tx/columnshard/engines/portions",
    # "//ydb/core/tx/data_events",
    # "//ydb/library/actors/core",
    # "//ydb/library/signals",
  ]

  deps = [
    "//ydb/core/tx/columnshard/engines/changes/abstract",
    # "//ydb/core/tx/columnshard/hooks/abstract",
    # "//ydb/library/accessor",
  ]

  sources = [
    "blob_constructor.cpp",
    "compacted_blob_constructor.cpp",
    "indexed_blob_constructor.cpp",
    "put_status.cpp",
    "write_controller.cpp",
  ]
}
