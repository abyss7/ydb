# Файлы этого каталога компилируются как часть engines (заголовки остались на месте).
# Узел index <-> tiering/scheme <-> engines взаимный по реальным символам:
# index.cpp создаёт TTieringActualizer/TSchemeActualizer, а tiering.cpp и scheme.cpp
# зовут TTieringProcessContext::AddPortion, чьё тело (context.cpp) — часть engines,
# которая, в свою очередь, через granule.h держит TGranuleActualizationIndex отсюда.
# Раздельными gn-таргетами они быть не могут без цикла.
# Этот таргет — форвардер для существующих потребителей ":scheme".
library("scheme") {
  public_deps = [ "//ydb/core/tx/columnshard/engines" ]

  sources = []
}
