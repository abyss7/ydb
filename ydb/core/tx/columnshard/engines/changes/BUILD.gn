# engines конструирует конкретные TCleanupPortions/TCleanupTables/TTTLColumnEngineChanges
# в TColumnEngineForLogs::StartCleanup*/StartTtl, а сами changes зовут невстроенные
# TGranuleMeta::OnCompaction*, TPortionsIndex::HasOlderIntervals и делают
# dynamic_cast<TColumnEngineForLogs> (нужен typeinfo из column_engine_logs.cpp).
# Раздельными gn-таргетами это неразрешимо; ya.make оставлен как был.
library("changes") {
  public_deps = [ "//ydb/core/tx/columnshard/engines" ]
  sources = []
}
