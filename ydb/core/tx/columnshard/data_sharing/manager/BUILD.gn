# yamake2gn: keep  -- hand-written, do not regenerate

library("shared_blobs") {
  public_deps = [ "//ydb/core/tablet_flat" ]

  deps = [
    "//ydb/core/tx/columnshard/blobs_action",
    "//ydb/library/actors/core",
  ]

  sources = [ "shared_blobs.cpp" ]
}

# sessions.cpp (TSessionsManager) is compiled inside //ydb/core/tx/columnshard
# together with the rest of the data-sharing session layer -- see the comment
# in that target's sources. :shared_blobs above stays a standalone leaf.
group("manager") {
  public_deps = [
    ":shared_blobs",
    "//ydb/core/tx/columnshard",
  ]
}
