library("abstract") {
  public_deps = [
    # "//ydb/core/base",
    # "//ydb/core/protos",
    # "//ydb/core/tx/columnshard",
    # "//ydb/core/tx/columnshard/blobs_action",
    # "//ydb/core/tx/columnshard/common",
    # "//ydb/core/tx/columnshard/data_sharing/manager",
    # storages_manager.cpp/storage.h используют только интерфейс
    # NColumnShard::ITiersManager из tiering/abstract/manager.h (лёгкий таргет).
    # Полный //ydb/core/tx/tiering тянул secret -> manager -> table_creator ->
    # tx_proxy и замыкал длинный цикл; в ya.make abstract пирит именно
    # tiering/abstract, так что это ещё и правка ошибки конверсии.
    "//ydb/core/tx/tiering:abstract",
    # "//ydb/core/util",
    # "//ydb/library/accessor",
    "//ydb/library/actors/core",
    # "//ydb/library/conclusion",
    # "//ydb/library/services",
    # ":common",
    # ":counters",
    ":events",
  ]

  deps = [
    # "//ydb/core/tx/columnshard/hooks/abstract",
    # ":protos",
  ]

  sources = [
    "abstract/action.cpp",
    "abstract/blob_set.cpp",
    "abstract/common.cpp",
    "abstract/gc.cpp",
    "abstract/gc_actor.cpp",
    "abstract/read.cpp",
    "abstract/remove.cpp",
    "abstract/storage.cpp",
    "abstract/storages_manager.cpp",
    "abstract/write.cpp",
  ]
}

