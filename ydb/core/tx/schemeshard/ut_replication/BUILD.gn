unittest_executable("ut_replication") {
  deps = [
    "//ydb/core/protos",
    "//ydb/core/tx/replication/controller",
    "//ydb/core/tx/schemeshard",  # peerdir only
    "//ydb/core/tx/schemeshard/ut_helpers",
    "//ydb/core/ydb_convert",
    "//ydb/public/api/protos",
    "//ydb/public/lib/ydb_cli/dump/util",
    "//ydb/public/sdk/cpp/src/client/draft",
    "//yql/essentials/public/udf",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [ "ut_replication.cpp" ]

  include_dirs = [
    "//ydb/core/tx/schemeshard",  # peerdir only
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
