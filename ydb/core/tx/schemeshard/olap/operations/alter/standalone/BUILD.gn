# These sources are schemeshard operations: they need TOperationContext and the
# compile environment of schemeshard_impl.h, and schemeshard's operation factory
# needs their Create*/Construct* symbols back. In gn that is one link unit, so
# library("schemeshard") compiles them directly. This target only redirects.

group("standalone") {
  public_deps = [ "//ydb/core/tx/schemeshard" ]
}
