executable("codegen") {
    _path = rebase_path(".", "//")
    _unique_name = exec_script("//build/gn/scripts/unique_name.py", [ _path ], "trim string")
    output_name = "${_unique_name}"

    deps += [
        "//contrib/libs/jinja2cpp",
        "//ydb/core/protos",
    ]
    sources = [ "main.cpp" ]
}
