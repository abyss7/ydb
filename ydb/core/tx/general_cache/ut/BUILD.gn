unittest_executable("ut") {
  deps = [
    "//library/cpp/monlib/dynamic_counters",
    "//library/cpp/testing/unittest",
    "//ydb/core/protos",
    "//ydb/core/tx/general_cache/service",
    "//ydb/library/actors/core",  # peerdir only
    "//ydb/library/signals",  # peerdir only
  ]

  sources = [ "ut_request_queue.cpp" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
