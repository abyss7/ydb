_gen_subdir = "$target_gen_dir/yql/essentials/minikql/computation"

copy("mkql_computation_node_codegen_h") {
  sources = [ "../mkql_computation_node_codegen.h.txt" ]
  outputs = [ "$_gen_subdir/mkql_computation_node_codegen.h" ]
}

copy("mkql_llvm_base_h") {
  sources = [ "../mkql_llvm_base.h.txt" ]
  outputs = [ "$_gen_subdir/mkql_llvm_base.h" ]
}

copy("mkql_block_impl_codegen_h") {
  sources = [ "../mkql_block_impl_codegen.h.txt" ]
  outputs = [ "$_gen_subdir/mkql_block_impl_codegen.h" ]
}

config("_includes") {
  include_dirs = [
    target_gen_dir,
    _gen_subdir,
  ]
}

library("llvm16") {
  sources = [
    "../mkql_computation_node_codegen.cpp",
    "../mkql_computation_node_graph.cpp",
    "../mkql_computation_node_graph_saveload.cpp",
    "../mkql_computation_node_holders_codegen.cpp",
    "../mkql_llvm_base.cpp",
  ]

  configs = [ ":_includes" ]

  deps = [
    ":mkql_block_impl_codegen_h",
    ":mkql_computation_node_codegen_h",
    ":mkql_llvm_base_h",
  ]

  public_deps = [
    "//contrib/libs/apache/arrow",
    "//contrib/libs/llvm16/lib/ExecutionEngine/MCJIT",
    "//contrib/libs/llvm16/lib/IR",
    "//contrib/libs/llvm16/lib/Linker",
    "//contrib/libs/llvm16/lib/Passes",
    "//contrib/libs/llvm16/lib/Target/X86",
    "//contrib/libs/llvm16/lib/Target/X86/AsmParser",
    "//contrib/libs/llvm16/lib/Target/X86/Disassembler",
    "//contrib/libs/llvm16/lib/Transforms/IPO",
    "//contrib/libs/llvm16/lib/Transforms/ObjCARC",
    "//library/cpp/enumbitset",
    "//library/cpp/packedtypes",
    "//library/cpp/random_provider",
    "//library/cpp/threading/future",
    "//library/cpp/time_provider",
    "//yql/essentials/minikql",
    "//yql/essentials/minikql/arrow",
    "//yql/essentials/minikql/codegen/llvm16",
    "//yql/essentials/minikql/computation",
    "//yql/essentials/parser/pg_wrapper/interface",
    "//yql/essentials/public/langver",
    "//yql/essentials/public/udf",
    "//yql/essentials/public/udf:arrow",
    "//yql/essentials/utils",
  ]
}
