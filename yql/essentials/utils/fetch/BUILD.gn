# yamake2gn: keep  -- hand-written, do not regenerate

config("private_config") {
  cflags = [ "-Wno-deprecated-enum-enum-conversion" ]
}

library("fetch") {
  public_deps = [
    "//library/cpp/http/io",
    # "//library/cpp/retry",
    "//library/cpp/uri",
  ]

  deps = [
    "//library/cpp/charset",
    # "//library/cpp/http/misc",
    "//library/cpp/openssl/io",
    "//yql/essentials/utils/log",
  ]

  sources = [ "fetch.cpp" ]

  configs = [ ":private_config" ]
}

protobuf_library("proto") {
  sources = [ "proto/fetch_config.proto" ]
}
